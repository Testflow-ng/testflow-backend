# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=

# Auth — JWT (generate with: openssl rand -base64 48). Must be >= 32 chars each and different.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies (leave blank in dev; e.g. .testflow.edu.ng in prod for apex sharing)
COOKIE_DOMAIN=

# Email (SMTP). If unset, verification/reset emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Rate limiting (optional; sane defaults applied in code)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=300

# --- Ads Manager (testflow.com.ng/ads) ---
ADS_CLIENT_URL=
ADS_JOBS_ENABLED=true
# Optional: Google Safe Browsing API key to screen advertiser links
GOOGLE_SAFE_BROWSING_KEY=
# >= 32 chars; defaults to a value derived from JWT_ACCESS_SECRET
ADS_EVENT_SECRET=
# Payment provider adapter: paystack | none (none => checkout returns 503 PAYMENT_NOT_CONFIGURED)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
ADS_PAYMENT_CALLBACK_URL=

# --- Cloudflare R2 object storage (replaces ImageKit) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=

# --- Centralized identity ---
# Share the session across subdomains (testflow.com.ng, ads.testflow.com.ng, ...). Production: .testflow.com.ng
COOKIE_DOMAIN=
# Extra browser origins allowed to call the API (comma-separated, no trailing slash). Add the Swagger docs site here.
ALLOWED_ORIGINS=
# CSRF double-submit token: off | log (warn only, default while frontends adopt the header) | enforce
CSRF_TOKEN_MODE=log
# Clients on OTHER domains (code + PKCE). JSON: [{"id":"partner","redirectUris":["https://partner.example/callback"]}]
AUTH_CLIENTS=

# --- Advertising: provider selection + Google AdSense ---
# The Testflow Ads marketplace keeps its own switches above. This only controls whether the
# advertising eligibility service offers it as a provider. Default: true.
ADVERTISING_TESTFLOW_ENABLED=true
# Google's publisher product. Nothing serves until the account and site are approved by Google.
GOOGLE_ADSENSE_ENABLED=false
# Public identifier, not a secret (it ships in the page). e.g. ca-pub-1234567890123456
GOOGLE_ADSENSE_PUBLISHER_ID=
# "placement:slotId" pairs, comma separated. Unknown placements and non-numeric slots are dropped
# and reported in /api/advertising/config.
GOOGLE_ADSENSE_AD_UNITS=
# Require an affirmative consent signal before personalized Google ads. Enable for EEA/UK traffic.
GOOGLE_ADSENSE_REQUIRE_CONSENT=false
# AdSense Management API reporting (publisher metrics). Off until OAuth credentials exist.
GOOGLE_ADSENSE_REPORTING_ENABLED=false
# Approved placements. Empty = the registry defaults. A sensitive placement can never be enabled.
ADVERTISING_PLACEMENTS_ENABLED=
ADVERTISING_PLACEMENTS_DISABLED=
# Where Paystack returns a student after a pass purchase. Defaults to <CLIENT_URL>/billing/complete
AD_FREE_CALLBACK_URL=
