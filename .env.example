# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=

# Auth — JWT (generate with: openssl rand -base64 48). Must be >= 32 chars each and different.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies (leave blank in dev; e.g. .testflow.edu.ng in prod for apex sharing)
COOKIE_DOMAIN=

# Email (SMTP). If unset, verification/reset emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Rate limiting (optional; sane defaults applied in code)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=300
