{
  "name": "testflow-server",
  "version": "1.0.0",
  "description": "TestFlow API server",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:eco": "node src/scripts/seed-eco.js",
    "seed:library": "node src/scripts/seed-library.js",
    "backfill:library": "node src/scripts/backfill-library-entitlement.js",
    "subscription:lifecycle": "node src/scripts/subscription-lifecycle.js",
    "create-admin": "node src/scripts/create-admin.js",
    "lint": "eslint src",
    "test": "node --env-file=.env.test --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --env-file=.env.test --test --test-concurrency=1 tests/*.unit.test.js tests/liveCbt.test.js",
    "test:integration": "node --env-file=.env.test --test --test-concurrency=1 tests/*.integration.test.js",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:status": "node --env-file=.env.test scripts/test-db-status.mjs",
    "test:db:reset": "node --env-file=.env.test scripts/test-db-reset.mjs",
    "format": "prettier --write src"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2"
  }
}
